---

<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Cuestionarios y Evaluaciones</h2>
    
    <div class="space-y-6">
        <!-- Listado de Cuestionarios -->
        <div class="space-y-4">
            <div class="p-4 border border-theme-rich-black/20 rounded-xl hover:bg-theme-keppel/5 transition-colors">
                <div class="flex justify-between items-center">
                    <div>
                        <h3 class="font-semibold">Evaluación de Desempeño Docente</h3>
                        <p class="text-sm text-gray-500">Matemáticas Avanzadas</p>
                    </div>
                    <span class="px-3 py-1 bg-theme-yellow/20 text-theme-yellow-dark rounded-full text-sm">Pendiente</span>
                </div>
            </div>

            <div class="p-4 border border-theme-rich-black/20 rounded-xl hover:bg-theme-keppel/5 transition-colors">
                <div class="flex justify-between items-center">
                    <div>
                        <h3 class="font-semibold">Satisfacción con Tutorías</h3>
                        <p class="text-sm text-gray-500">Programación I</p>
                    </div>
                    <span class="px-3 py-1 bg-theme-keppel/20 text-theme-keppel-dark rounded-full text-sm">Completado</span>
                </div>
            </div>

            <div class="p-4 border border-theme-rich-black/20 rounded-xl hover:bg-theme-keppel/5 transition-colors">
                <div class="flex justify-between items-center">
                    <div>
                        <h3 class="font-semibold">Encuesta de Servicios Universitarios</h3>
                        <p class="text-sm text-gray-500">General</p>
                    </div>
                    <span class="px-3 py-1 bg-gray-100 text-gray-500 rounded-full text-sm">Disponible en 3 días</span>
                </div>
            </div>
        </div>

        <!-- Botón de Nueva Evaluación -->
        <button class="mt-6 w-full md:w-auto bg-theme-keppel text-theme-rich-black border-2 border-b-8 border-theme-rich-black font-medium py-2 px-6 rounded-2xl hover:bg-theme-keppel/90 transition-colors duration-200">
            Comenzar Nueva Evaluación
        </button>
    </div>
</div>