<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
        <h2 class="text-2xl font-bold text-theme-rich-black">Perfil de Estudiante</h2>
    </div>
    
    <div class="flex flex-col md:flex-row gap-8">
        <div class="flex flex-col items-center">
            <div class="relative w-32 h-32 rounded-full bg-theme-keppel/20 flex items-center justify-center overflow-hidden border-4 border-theme-keppel/30">
                <span id="genderIcon" class="text-5xl">
                    <!-- Se llenará dinámicamente -->
                </span>
            </div>
            <button class="mt-4 text-theme-keppel hover:text-theme-keppel-dark text-sm font-medium text-center w-full">
                Cambiar foto
