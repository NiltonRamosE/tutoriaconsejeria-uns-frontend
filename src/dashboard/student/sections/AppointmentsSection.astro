<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Programación de Citas</h2>
    
    <!-- Selector de Modalidad -->
    <div class="mb-8">
        <h3 class="text-lg font-semibold mb-4 text-theme-rich-black">Selecciona el tipo de cita</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <button id="individualBtn" class="modalidad-btn bg-theme-keppel/20 border-2 border-theme-keppel text-theme-rich-black p-4 rounded-xl text-center transition-all duration-200 hover:bg-theme-keppel/30 hover:scale-[1.02] active:scale-[0.98]">
                <div class="flex flex-col items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mb-2 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="font-medium">Cita Individual</span>
                    <p class="text-sm mt-1 text-theme-rich-black/70">Solo para ti</p>
                </div>
            </button>
            
            <button id="groupBtn" class="modalidad-btn bg-theme-seasalt border-2 border-theme-rich-black/20 text-theme-rich-black p-4 rounded-xl text-center transition-all duration-200 hover:bg-theme-seasalt-dark hover:scale-[1.02] active:scale-[0.98]">
                <div class="flex flex-col items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mb-2 text-theme-rich-black/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span class="font-medium">Cita Grupal</span>
                    <p class="text-sm mt-1 text-theme-rich-black/70">Con otros estudiantes</p>
                </div>
            </button>
        </div>
    </div>
    
    <!-- Formulario de Cita -->
    <div id="appointmentFormContainer" class="hidden">
        <form id="appointmentForm" class="space-y-6">
            <!-- Paso 1: Selección de Docente -->
            <div class="form-step active" data-step="1">
                <h3 class="text-lg font-semibold mb-4 text-theme-rich-black flex items-center">
                    <span class="bg-theme-keppel text-white rounded-full h-8 w-8 flex items-center justify-center mr-2">1</span>
                    Selecciona un docente
                </h3>
                
                <div class="mb-4">
                    <label for="instructorSelect" class="block text-sm font-medium mb-2 text-theme-rich-black/80">Docente</label>
                    <select id="instructorSelect" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent transition-all duration-200" required>
                        <option value="">Seleccione un docente</option>
                        <!-- Las opciones se llenarán dinámicamente -->
                    </select>
                </div>

                <div class="flex justify-end">
                    <button type="button" class="next-step-btn bg-theme-keppel text-white font-medium py-2 px-6 rounded-lg hover:bg-theme-keppel-dark transition-colors duration-200">
                        Siguiente
                    </button>
                </div>
            </div>

            <!-- Paso 2: Tipo de Actividad y Estudiantes (solo para citas grupales) -->
            <div class="form-step hidden" data-step="2" id="groupStep">
                <h3 class="text-lg font-semibold mb-4 text-theme-rich-black flex items-center">
                    <span class="bg-theme-keppel text-white rounded-full h-8 w-8 flex items-center justify-center mr-2">2</span>
                    Selecciona estudiantes para la cita grupal
                </h3>
                
                <!-- Tipo de Actividad (solo visible cuando bothActivities es true) -->
                <div id="typeActivityContainer" class="hidden mb-4">
                    <label class="block text-sm font-medium mb-2 text-theme-rich-black/80">Tipo de Actividad</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <label class="activity-type-option">
                            <input type="radio" name="typeActivity" value="T" class="sr-only">
                            <div class="p-4 border-2 border-theme-rich-black/20 rounded-lg text-center cursor-pointer transition-all duration-200 hover:border-theme-keppel hover:bg-theme-keppel/5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                                </svg>
                                <span>Tutoría</span>
                            </div>
                        </label>
                        <label class="activity-type-option">
                            <input type="radio" name="typeActivity" value="C" class="sr-only">
                            <div class="p-4 border-2 border-theme-rich-black/20 rounded-lg text-center cursor-pointer transition-all duration-200 hover:border-theme-keppel hover:bg-theme-keppel/5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto mb-2 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                </svg>
                                <span>Consejería</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Selección de Estudiantes (solo para citas grupales) -->
                <div id="studentsContainer" class="mb-6">
                    <span class="block text-sm font-medium mb-2 text-theme-rich-black/80">Selecciona estudiantes</span>
                    <div class="border border-theme-rich-black/20 rounded-lg p-3 max-h-60 overflow-y-auto">
                        <div id="studentsList" class="space-y-2">
                            <!-- Los estudiantes se cargarán dinámicamente -->
                        </div>
                    </div>
                    <p id="noStudentsMessage" class="text-sm text-gray-500 mt-2 hidden">No hay estudiantes disponibles para este docente y tipo de actividad.</p>
                </div>

                <div class="flex justify-between">
                    <button type="button" class="prev-step-btn bg-theme-rich-black/10 text-theme-rich-black font-medium py-2 px-6 rounded-lg hover:bg-theme-rich-black/20 transition-colors duration-200">
                        Anterior
                    </button>
                    <button type="button" class="next-step-btn bg-theme-keppel text-white font-medium py-2 px-6 rounded-lg hover:bg-theme-keppel-dark transition-colors duration-200">
                        Siguiente
                    </button>
                </div>
            </div>

            <!-- Paso 3: Detalles de la cita -->
            <div class="form-step hidden" data-step="3" id="detailsStep">
                <h3 class="text-lg font-semibold mb-4 text-theme-rich-black flex items-center">
                    <span class="bg-theme-keppel text-white rounded-full h-8 w-8 flex items-center justify-center mr-2">
                        <span id="stepNumber">3</span>
                    </span>
                    <span id="stepTitle">Completa los detalles de la cita</span>
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <!-- Método de Cita -->
                    <div>
                        <label class="block text-sm font-medium mb-2 text-theme-rich-black/80">Método de Cita</label>
                        <select id="appointmentMethod" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent">
                            <option value="">Seleccione un método</option>
                            <option value="A">Personal</option>
                            <option value="B">Telefónica</option>
                            <option value="C">Correo electrónico</option>
                            <option value="D">Chat</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <!-- Método Específico de Cita -->
                    <div id="specificMethodContainer" class="hidden">
                        <label for="specificAppointmentMethod" class="block text-sm font-medium mb-2 text-theme-rich-black/80">Método Específico</label>
                        <input type="text" id="specificAppointmentMethod" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" placeholder="Ej: Google Meet, Zoom, etc.">
                    </div>

                    <!-- Razón de la Cita -->
                    <div>
                        <label class="block text-sm font-medium mb-2 text-theme-rich-black/80">Razón de la Cita</label>
                        <select id="appointmentReason" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent">
                            <option value="">Seleccione una razón</option>
                            <option value="A">Rendimiento académico</option>
                            <option value="B">Mejorar técnicas de estudio</option>
                            <option value="C">Problemas de aprendizaje</option>
                            <option value="D">Problemas interpersonales con estudiantes</option>
                            <option value="E">Problemas de salud</option>
                            <option value="F">Problemas interpersonales con docentes</option>
                            <option value="G">Problemas interpersonales con otras personas</option>
                            <option value="H">Problemas económicos</option>
                            <option value="I">Problemas afectivos</option>
                            <option value="J">Problemas familiares</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <!-- Razón Específica de la Cita -->
                    <div id="specificReasonContainer" class="hidden">
                        <label for="specificAppointmentReason" class="block text-sm font-medium mb-2 text-theme-rich-black/80">Razón Específica</label>
                        <input type="text" id="specificAppointmentReason" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" placeholder="Describa brevemente la razón de la cita">
                    </div>
                </div>

                <!-- Horarios Alternativos -->
                <div class="mb-4">
                    <label class="block text-sm font-medium mb-2 text-theme-rich-black/80">Horarios Alternativos</label>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div>
                            <label for="altScheduleA" class="block text-sm font-medium mb-1 text-theme-rich-black/70">Primera Opción</label>
                            <input type="datetime-local" id="altScheduleA" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
                        </div>
                        <div>
                            <label for="altScheduleB" class="block text-sm font-medium mb-1 text-theme-rich-black/70">Segunda Opción</label>
                            <input type="datetime-local" id="altScheduleB" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
                        </div>
                        <div>
                            <label for="altScheduleC" class="block text-sm font-medium mb-1 text-theme-rich-black/70">Tercera Opción</label>
                            <input type="datetime-local" id="altScheduleC" class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between">
                    <button type="button" class="prev-step-btn bg-theme-rich-black/10 text-theme-rich-black font-medium py-2 px-6 rounded-lg hover:bg-theme-rich-black/20 transition-colors duration-200">
                        Anterior
                    </button>
                    <button type="submit" class="bg-theme-keppel text-white font-medium py-2 px-6 rounded-lg hover:bg-theme-keppel-dark transition-colors duration-200">
                        Programar Cita
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script is:inline>
    let currentStep = 1;
    let selectedModality = '';
    let selectedInstructor = null;
    let selectedStudents = [];
    let availableStudents = [];

    document.addEventListener('DOMContentLoaded', async () => {
        await loadInstructors();
        setupEventListeners();
    });

    // Configurar event listeners
    function setupEventListeners() {
        // Selector de modalidad
        document.getElementById('individualBtn').addEventListener('click', () => selectModality('I'));
        document.getElementById('groupBtn').addEventListener('click', () => selectModality('G'));
        
        // Navegación entre pasos
        document.querySelectorAll('.next-step-btn').forEach(btn => {
            btn.addEventListener('click', nextStep);
        });
        
        document.querySelectorAll('.prev-step-btn').forEach(btn => {
            btn.addEventListener('click', prevStep);
        });
        
        // Listeners para campos condicionales
        document.getElementById('appointmentMethod').addEventListener('change', function() {
            toggleFieldVisibility('specificMethodContainer', this.value === 'Otro');
        });
        
        document.getElementById('appointmentReason').addEventListener('change', function() {
            toggleFieldVisibility('specificReasonContainer', this.value === 'Otro');
        });
        
        // Listener para tipo de actividad
        document.querySelectorAll('.activity-type-option input').forEach(radio => {
            radio.addEventListener('change', () => {
                if (selectedModality === 'G') {
                    filterStudentsByActivity();
                }
            });
        });
        
        // Listener para envío del formulario
        document.getElementById('appointmentForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            await submitAppointmentForm();
        });
    }

    // Seleccionar modalidad
    function selectModality(modality) {
        selectedModality = modality;
        
        // Resetear al paso 1 cuando se cambia de modalidad
        resetToStep1();
        
        // Actualizar UI
        document.querySelectorAll('.modalidad-btn').forEach(btn => {
            btn.classList.remove('bg-theme-keppel/20', 'border-theme-keppel');
            btn.classList.add('bg-theme-seasalt', 'border-theme-rich-black/20');
        });
        
        const selectedBtn = document.getElementById(modality === 'I' ? 'individualBtn' : 'groupBtn');
        selectedBtn.classList.remove('bg-theme-seasalt', 'border-theme-rich-black/20');
        selectedBtn.classList.add('bg-theme-keppel/20', 'border-theme-keppel');
        
        // Mostrar formulario
        document.getElementById('appointmentFormContainer').classList.remove('hidden');
        
        // Configurar campos según modalidad
        if (modality === 'G') {
            document.getElementById('studentsContainer').classList.remove('hidden');
        } else {
            document.getElementById('studentsContainer').classList.add('hidden');
        }
    }

    // Resetear al paso 1
    function resetToStep1() {
        currentStep = 1;
        selectedStudents = [];
        
        // Ocultar todos los pasos excepto el 1
        document.querySelectorAll('.form-step').forEach(step => {
            step.classList.add('hidden');
        });
        document.querySelector('.form-step[data-step="1"]').classList.remove('hidden');
        const instructorSelect = document.getElementById('instructorSelect');
        instructorSelect.selectedIndex = 0; // No selecciona ninguna opción
;
        // Actualizar número y título del paso final
        updateFinalStepInfo();
    }

    // Actualizar información del paso final según la modalidad
    function updateFinalStepInfo() {
        const stepNumber = document.getElementById('stepNumber');
        const stepTitle = document.getElementById('stepTitle');
        
        if (selectedModality === 'I') {
            // Para citas individuales, el número de paso depende de si hay bothActivities
            const totalSteps = (selectedInstructor && selectedInstructor.bothActivities) ? 3 : 2;
            stepNumber.textContent = totalSteps;
            stepTitle.textContent = `Completa los detalles de la cita individual`;
        } else {
            // Para citas grupales, siempre son 3 pasos
            stepNumber.textContent = '3';
            stepTitle.textContent = 'Completa los detalles de la cita grupal';
        }
    }

    // Cargar instructores
    async function loadInstructors() {
        try {
            const studentData = JSON.parse(localStorage.getItem('user')) || null;
            if (!studentData?.id) {
                console.error('No se encontró información del estudiante');
                return;
            }

            const token = localStorage.getItem('token');
            if (!token) {
                console.error('No hay token de autenticación');
                return;
            }

            const response = await fetch(`http://localhost:8080/student/assigned/instructor/${studentData.id}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (response.ok) {
                const instructors = await response.json();
                populateInstructorSelect(instructors);
            } else {
                console.error('Error al cargar los instructores:', response.statusText);
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Llenar select de instructores
    function populateInstructorSelect(instructors) {
        const select = document.getElementById('instructorSelect');
        
        // Limpiar opciones excepto la primera
        while (select.options.length > 1) {
            select.remove(1);
        }
        
        // Agregar instructores
        instructors.forEach(instructor => {
            const option = document.createElement('option');
            option.value = instructor.id;
            option.textContent = instructor.fullName;
            option.dataset.typeActivity = instructor.typeActivity;
            option.dataset.bothActivities = instructor.bothActivities;
            select.appendChild(option);
        });
        
        // Listener para cambio de instructor
        select.addEventListener('change', async function() {
            const selectedOption = this.options[this.selectedIndex];
            selectedInstructor = {
                id: selectedOption.value,
                typeActivity: selectedOption.dataset.typeActivity,
                bothActivities: selectedOption.dataset.bothActivities === 'true'
            };
            
            // Mostrar/ocultar selector de tipo de actividad
            toggleFieldVisibility('typeActivityContainer', selectedInstructor.bothActivities);
            
            // Si es cita grupal, cargar estudiantes
            if (selectedModality === 'G' && selectedInstructor.id) {
                await loadStudents(selectedInstructor.id);
            }
            
            // Actualizar la numeración de pasos
            updateFinalStepInfo();
        });
    }

    // Cargar estudiantes para cita grupal
    async function loadStudents(instructorId) {
        try {
            const token = localStorage.getItem('token');
            if (!token) {
                console.error('No hay token de autenticación');
                return;
            }

            const response = await fetch(`http://localhost:8080/student/assigned/${instructorId}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (response.ok) {
                availableStudents = await response.json();
                filterStudentsByActivity();
            } else {
                console.error('Error al cargar los estudiantes:', response.statusText);
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Filtrar estudiantes por tipo de actividad
    function filterStudentsByActivity() {
        const studentsList = document.getElementById('studentsList');
        const noStudentsMessage = document.getElementById('noStudentsMessage');
        studentsList.innerHTML = '';
        
        let activityType;
        if (selectedInstructor.bothActivities) {
            const selectedActivity = document.querySelector('input[name="typeActivity"]:checked');
            activityType = selectedActivity ? selectedActivity.value : null;
        } else {
            activityType = selectedInstructor.typeActivity;
        }
        
        if (!activityType) {
            noStudentsMessage.classList.remove('hidden');
            return;
        }
        
        // Obtener el ID del estudiante en sesión
        const studentData = JSON.parse(localStorage.getItem('user')) || null;
        const currentStudentId = studentData?.id ? studentData.id.toString() : null;
        
        // Filtrar estudiantes por tipo de actividad y excluir al estudiante actual
        const filteredStudents = availableStudents.filter(student => 
            student.typeActivityCode === activityType && 
            student.id.toString() !== currentStudentId
        );
        
        if (filteredStudents.length === 0) {
            noStudentsMessage.classList.remove('hidden');
            return;
        }
        
        noStudentsMessage.classList.add('hidden');
        filteredStudents.forEach(student => {
            const studentEl = document.createElement('div');
            studentEl.className = 'flex items-center p-2 border border-theme-rich-black/10 rounded hover:bg-theme-keppel/5 cursor-pointer transition-colors duration-200';
            studentEl.innerHTML = `
                <input type="checkbox" id="student-${student.id}" value="${student.id}" class="mr-2 student-checkbox">
                <label for="student-${student.id}" class="cursor-pointer flex-1">${student.fullName}</label>
            `;
            studentsList.appendChild(studentEl);
        });
        
        // Listener para checkboxes
        document.querySelectorAll('.student-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', (e) => {
                if (e.target.checked) {
                    selectedStudents.push(e.target.value);
                } else {
                    selectedStudents = selectedStudents.filter(id => id !== e.target.value);
                }
            });
        });
    }

    // Navegar al siguiente paso
    function nextStep() {
        if (validateStep(currentStep)) {
            document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('hidden');
            
            // Determinar el siguiente paso según la modalidad y bothActivities
            if (selectedModality === 'I') {
                if (currentStep === 1 && selectedInstructor && selectedInstructor.bothActivities) {
                    // Para citas individuales con bothActivities=true, ir al paso 2
                    currentStep = 2;
                } else if (currentStep === 1) {
                    // Para citas individuales con bothActivities=false, saltar al paso 3
                    currentStep = 3;
                } else if (currentStep === 2) {
                    // Del paso 2 al 3 en citas individuales
                    currentStep = 3;
                }
            } else {
                // Para citas grupales, flujo normal
                currentStep++;
            }
            
            document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.remove('hidden');
            updateFinalStepInfo();
        }
    }

    // Navegar al paso anterior
    function prevStep() {
        document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('hidden');
        
        // Determinar el paso anterior según la modalidad y bothActivities
        if (selectedModality === 'I') {
            if (currentStep === 3 && selectedInstructor && selectedInstructor.bothActivities) {
                // Volver del paso 3 al 2 en citas individuales con bothActivities=true
                currentStep = 2;
            } else if (currentStep === 3) {
                // Volver del paso 3 al 1 en citas individuales con bothActivities=false
                currentStep = 1;
            } else if (currentStep === 2) {
                // Volver del paso 2 al 1
                currentStep = 1;
            }
        } else {
            // Para citas grupales, flujo normal
            currentStep--;
        }
        
        document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.remove('hidden');
        updateFinalStepInfo();
    }

    // Validar paso actual
    function validateStep(step) {
        // Implementar validación según el paso
        return true;
    }

    // Mostrar/ocultar campo
    function toggleFieldVisibility(fieldId, show) {
        const field = document.getElementById(fieldId);
        if (show) {
            field.classList.remove('hidden');
        } else {
            field.classList.add('hidden');
        }
    }

    // Enviar formulario
    async function submitAppointmentForm() {
        try {
            const studentData = JSON.parse(localStorage.getItem('user')) || null;
            if (!studentData?.id) {
                alert('No se encontró información del estudiante');
                return;
            }

            const token = localStorage.getItem('token');
            if (!token) {
                alert('No hay token de autenticación');
                return;
            }

            // Obtener tipo de actividad
            let typeActivityCode;
            if (selectedInstructor.bothActivities) {
                const selectedActivity = document.querySelector('input[name="typeActivity"]:checked');
                typeActivityCode = selectedActivity ? selectedActivity.value : null;
            } else {
                typeActivityCode = selectedInstructor.typeActivity;
            }

            if (!typeActivityCode) {
                alert('Por favor selecciona un tipo de actividad');
                return;
            }

            // Preparar datos base comunes
            const baseRequestData = {
                appointmentModalityCode: selectedModality,
                appointmentMethod: document.getElementById('appointmentMethod').value === 'Otro' ? null : document.getElementById('appointmentMethod').value,
                specificAppointmentMethod: document.getElementById('specificAppointmentMethod').value || null,
                appointmentReason: document.getElementById('appointmentReason').value === 'Otro' ? null : document.getElementById('appointmentReason').value,
                specificAppointmentReason: document.getElementById('specificAppointmentReason').value || null,
                typeActivityCode: typeActivityCode,
                instructorId: parseInt(selectedInstructor.id),
                altScheduleA: document.getElementById('altScheduleA').value,
                altScheduleB: document.getElementById('altScheduleB').value,
                altScheduleC: document.getElementById('altScheduleC').value
            };

            let endpoint;
            let requestData;

            if (selectedModality === 'I') {
                // Cita individual
                endpoint = 'http://localhost:8080/student/appointment/individual';
                requestData = {
                    ...baseRequestData,
                    studentId: studentData.id
                };
            } else {
                // Cita grupal
                endpoint = 'http://localhost:8080/student/appointment/group';
                
                // Incluir al estudiante actual en la lista de estudiantes para la cita grupal
                const allStudentIds = [...selectedStudents, studentData.id.toString()];
                
                requestData = {
                    ...baseRequestData,
                    studentsId: allStudentIds.map(id => parseInt(id))
                };
            }

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(requestData)
            });

            if (response.ok) {
                const result = await response.json();
                
                if (selectedModality === 'I') {
                    alert('Cita individual programada exitosamente');
                } else {
                    alert(`Cita grupal programada exitosamente para ${result.length} participantes`);
                }
                
                resetForm();
            } else {
                const error = await response.text();
                alert('Error al programar la cita: ' + error);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error al programar la cita');
        }
    }

    // Reiniciar formulario
    function resetForm() {
        document.getElementById('appointmentForm').reset();
        selectedModality = '';
        selectedInstructor = null;
        selectedStudents = [];
        currentStep = 1;
        
        // Reset UI
        document.querySelectorAll('.modalidad-btn').forEach(btn => {
            btn.classList.remove('bg-theme-keppel/20', 'border-theme-keppel');
            btn.classList.add('bg-theme-seasalt', 'border-theme-rich-black/20');
        });
        
        document.getElementById('appointmentFormContainer').classList.add('hidden');
        document.querySelectorAll('.form-step').forEach(step => {
            step.classList.add('hidden');
        });
        document.querySelector('.form-step[data-step="1"]').classList.remove('hidden');
    }
</script>

<style>
    .modalidad-btn {
        transition: all 0.2s ease;
    }
    
    .modalidad-btn:hover {
        transform: translateY(-2px);
    }
    
    .activity-type-option input:checked + div {
        border-color: #2A9D8F;
        background-color: rgba(42, 157, 143, 0.1);
    }
    
    .form-step {
        transition: opacity 0.3s ease;
    }
</style>