---
---

<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Gestión de Citas</h2>
    
    <div class="space-y-6">
        <!-- Citas Programadas -->
        <div>
            <h3 class="text-lg font-semibold mb-4">Mis Citas Programadas</h3>
            <div class="space-y-3">
                <div class="p-4 border border-theme-rich-black/20 rounded-xl bg-white">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-medium">Tutoría de Matemáticas</h4>
                            <p class="text-sm text-gray-500">Con: Prof. Juan Pérez</p>
                            <p class="text-sm text-gray-500">15 Marzo, 3:00 PM - 4:00 PM</p>
                        </div>
                        <button class="text-red-500 hover:text-red-700 text-sm font-medium">Cancelar</button>
                    </div>
                </div>

                <div class="p-4 border border-theme-rich-black/20 rounded-xl bg-white">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-medium">Consejería Académica</h4>
                            <p class="text-sm text-gray-500">Con: Dra. María Gómez</p>
                            <p class="text-sm text-gray-500">22 Marzo, 10:00 AM - 10:30 AM</p>
                        </div>
                        <button class="text-red-500 hover:text-red-700 text-sm font-medium">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Programar Nueva Cita -->
        <div class="pt-4 border-t border-theme-rich-black/20">
            <h3 class="text-lg font-semibold mb-4">Programar Nueva Cita</h3>
            <form class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Tipo de Cita</label>
                    <select class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                        <option>Tutoría Académica</option>
                        <option>Consejería</option>
                        <option>Asesoría de Proyecto</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1">Fecha</label>
                    <input type="date" class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                </div>

                <button type="submit" class="w-full bg-theme-keppel text-theme-rich-black border-2 border-b-8 border-theme-rich-black font-medium py-3 px-6 rounded-2xl hover:bg-theme-keppel/90 transition-colors duration-200">
                    Programar Cita
                </button>
            </form>
        </div>
    </div>
</div>