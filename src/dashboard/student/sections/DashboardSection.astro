<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Mi Panel Principal</h2>
    
    <div class="space-y-6">
        <!-- Tarjeta de Bienvenida -->
        <div class="p-6 bg-theme-keppel/10 rounded-xl border border-theme-keppel">
            <h3 class="text-xl font-semibold mb-2">¡Bienvenido de vuelta!</h3>
            <p class="text-gray-600">Tienes 3 actividades pendientes para esta semana.</p>
        </div>

        <!-- Estadísticas Rápidas -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 bg-white rounded-xl border border-theme-rich-black/20">
                <p class="text-sm text-gray-500">Tutorías Programadas</p>
                <p class="text-2xl font-bold">2</p>
            </div>
            <div class="p-4 bg-white rounded-xl border border-theme-rich-black/20">
                <p class="text-sm text-gray-500">Evaluaciones Pendientes</p>
                <p class="text-2xl font-bold">1</p>
            </div>
            <div class="p-4 bg-white rounded-xl border border-theme-rich-black/20">
                <p class="text-sm text-gray-500">Próxima Cita</p>
                <p class="text-2xl font-bold">Mar 15</p>
            </div>
        </div>

        <!-- Calendario de Actividades -->
        <div class="p-6 bg-white rounded-xl border border-theme-rich-black/20">
            <h3 class="text-lg font-semibold mb-4">Próximas Actividades</h3>
            <ul class="space-y-3">
                <li class="flex items-center">
                    <div class="w-2 h-2 bg-theme-keppel rounded-full mr-3"></div>
                    <span>Tutoría de Matemáticas - Hoy 3:00 PM</span>
                </li>
                <li class="flex items-center">
                    <div class="w-2 h-2 bg-theme-blue rounded-full mr-3"></div>
                    <span>Evaluación a Docente - Vence en 2 días</span>
                </li>
                <li class="flex items-center">
                    <div class="w-2 h-2 bg-theme-yellow rounded-full mr-3"></div>
                    <span>Cita con Consejero - Mar 15, 10:00 AM</span>
                </li>
            </ul>
        </div>
    </div>
</div>