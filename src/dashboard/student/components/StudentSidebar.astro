---
import StudentProfileCard from '@/dashboard/student/components/StudentProfileCard.astro';
import LogoutButton from '@/shared/components/LogoutButton.astro';
import ItemSidebar from '@/shared/components/ItemSidebar.astro';

---

<aside class="lg:col-span-1 space-y-6">
    <!-- Perfil del Estudiante -->
    <StudentProfileCard />
    
    <!-- Navegación -->
    <div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
        <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Mis Opciones</h2>
        
        <nav class="space-y-4">
            <!-- Dashboard -->

            <ItemSidebar
                href="#"
                section="dashboard"
                title="Inicio"
                description="Resumen de actividades"
                iconSrc="/src/assets/icons/four-square.svg"
            />

            <ItemSidebar
                href="#"
                section="evaluate"
                title="Evaluar Docente"
                description="Comparte tu retroalimentación"
                iconSrc="/src/assets/icons/writing-in-paper.svg"
            />

            <ItemSidebar
                href="#"
                section="surveys"
                title="Cuestionarios"
                description="Registro de evaluaciones"
                iconSrc="/src/assets/icons/paper.svg"
            />

            <ItemSidebar
                href="#"
                section="appointments"
                title="Programar Cita"
                description="Agenda tutorías o consejería"
                iconSrc="/src/assets/icons/calendar-blank.svg"
            />
            
            <!-- Cerrar Sesión -->
            <div class="pt-4 border-t border-theme-rich-black/20">
                <LogoutButton />
            </div>
        </nav>
    </div>
</aside>