---
import StudentProfileCard from '@/dashboard/student/components/StudentProfileCard.astro';
import LogoutButton from '@/shared/components/LogoutButton.astro';

const { currentSection } = Astro.props;
---

<aside class="lg:col-span-1 space-y-6">
    <!-- Perfil del Estudiante -->
    <StudentProfileCard />
    
    <!-- Navegación -->
    <div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
        <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Mis Opciones</h2>
        
        <nav class="space-y-4">
            <!-- Dashboard -->
            <a 
                href="#"
                data-section="dashboard"
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentSection === 'dashboard' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Inicio</h3>
                        <p class="text-sm text-gray-600">Resumen de actividades</p>
                    </div>
                </div>
            </a>
            
            <!-- Evaluar Docente -->
            <a 
                href="#"
                data-section="evaluate"
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentSection === 'evaluate' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Evaluar Docente</h3>
                        <p class="text-sm text-gray-600">Comparte tu retroalimentación</p>
                    </div>
                </div>
            </a>
            
            <!-- Cuestionarios -->
            <a 
                href="#"
                data-section="surveys"
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentSection === 'surveys' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Cuestionarios</h3>
                        <p class="text-sm text-gray-600">Registro de evaluaciones</p>
                    </div>
                </div>
            </a>
            
            <!-- Citas -->
            <a 
                href="#"
                data-section="appointments"
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentSection === 'appointments' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Programar Cita</h3>
                        <p class="text-sm text-gray-600">Agenda tutorías o consejería</p>
                    </div>
                </div>
            </a>
            
            <!-- Cerrar Sesión -->
            <div class="pt-4 border-t border-theme-rich-black/20">
                <LogoutButton />
            </div>
        </nav>
    </div>
</aside>