---
const { user = { name: "Docente", email: "docente@institucion.edu", role: "Tutor" } } = Astro.props;
---

<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <div class="flex items-center">
        <div class="mr-4 w-16 h-16 bg-theme-blue/20 rounded-2xl flex items-center justify-center">
            <span class="text-2xl text-theme-blue">👩‍🏫</span>
        </div>
        <div>
            <h2 class="text-xl font-bold text-theme-rich-black">{user.name}</h2>
            <p class="text-sm text-gray-600">{user.email}</p>
        </div>
    </div>
    <div class="mt-4 pt-4 border-t border-theme-rich-black/20">
        <p class="text-sm font-light text-gray-600">Rol: {user.role}</p>
        <p class="text-sm font-light text-gray-600">Departamento: Ciencias Exactas</p>
        <p class="text-sm font-light text-gray-600">Tutorados: 12 estudiantes</p>
    </div>
</div>