<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Gestión de Citas</h2>
    
    <div class="space-y-8">
        <h5 class="font-light">Es posible que necesites recargar la página para tener las citas actualizadas</h5>
        <!-- Citas Solicitadas por el Estudiante -->
        <div>
            <h3 class="text-lg font-semibold mb-4 text-theme-rich-black">Citas que he solicitado</h3>
            <div id="sentAppointmentsContainer" class="space-y-3">
                <!-- Las citas se cargarán dinámicamente aquí -->
                <div class="text-center py-8 text-gray-500">
                    <p>Cargando citas solicitadas...</p>
                </div>
            </div>
        </div>

        <!-- Citas Recibidas de Instructores -->
        <div>
            <h3 class="text-lg font-semibold mb-4 text-theme-rich-black">Citas que he recibido</h3>
            <div id="receivedAppointmentsContainer" class="space-y-3">
                <!-- Las citas se cargarán dinámicamente aquí -->
                <div class="text-center py-8 text-gray-500">
                    <p>Cargando citas recibidas...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module" is:inline>
    import { fetchAppointmentsSent, fetchAppointmentsReceived, fetchPutAppointmentConfirm, fetchPutAppointmentCancel } from '/src/dashboard/services/instructorService.js'
    import {getToken, getUser} from '/src/dashboard/shared/auth.js';
    import { formatDate, formatTime, showError, getDayName, getAppointmentStatusInfo } from '/src/dashboard/shared/appointmentScheduleManager.js';
    const instructorData = getUser();
    const token = getToken();

    document.addEventListener('DOMContentLoaded', async () => {
        await loadAppointments();
    });

    async function loadAppointments() {
        try {
            if (!instructorData || !instructorData.id) {
                console.error('No se encontró información del instructor');
                showError('No se encontró información del instructor');
                return;
            }
            const sentAppointments = await fetchAppointmentsSent(instructorData.id, token);
            displayAppointments(sentAppointments, 'sentAppointmentsContainer', true);

            const receivedResponse = await fetchAppointmentsReceived(instructorData.id, token);
            displayAppointments(receivedResponse, 'receivedAppointmentsContainer', false);

        } catch (error) {
            console.error('Error:', error);
            showError('Error al cargar las citas');
        }
    }

    async function confirmAppointment(appointmentId, chosenDateTime) {
        try {
            await fetchPutAppointmentConfirm(appointmentId, chosenDateTime, token);
            alert('Cita confirmada exitosamente');
            await loadAppointments();
        } catch (err) {
            console.error('Error confirmando cita:', err);
            alert('Error al confirmar la cita');
        }
    }

    async function cancelAppointment(appointmentId) {
        try {
            await fetchPutAppointmentCancel(appointmentId, token);
            alert('Cita cancelada exitosamente');
            await loadAppointments();
        } catch (err) {
            console.error('Error cancelando cita:', err);
            alert('Error al cancelar la cita');
        }
    }

    function displayAppointments(appointments, containerId, isSent) {
        const container = document.getElementById(containerId);

        if (!appointments || appointments.length === 0) {
            container.innerHTML = `
                <div class="text-center py-12 text-gray-500 bg-gradient-to-br from-theme-seasalt to-white rounded-2xl border border-dashed border-theme-rich-black/20">
                    <img src="/src/assets/icons/calendar-blank.svg" class="h-12 w-12 mx-auto text-gray-400 mb-3" alt="Calendar icon"/>
                    <p class="text-lg font-medium">No hay citas ${isSent ? 'solicitadas' : 'recibidas'}</p>
                    <p class="text-sm mt-1">Cuando tengas citas, aparecerán aquí</p>
                </div>
            `;
            return;
        }

        container.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';
        
        container.innerHTML = appointments.map(appointment => {
            const { appointmentResponse: apptDetails, senderFullName, receiverFullName, receiverStudentsFullNames } = appointment;
            
            const formattedDate = apptDetails.date ? formatDate(apptDetails.date) : '--';
            const formattedStartTime = apptDetails.startTime ? formatTime(apptDetails.startTime) : '--:--';
            const formattedEndTime = apptDetails.endTime ? formatTime(apptDetails.endTime) : '--:--';
            
            let statusClass = '';
            let statusIcon = '';
            ({ statusClass, statusIcon } = getAppointmentStatusInfo(apptDetails.state));

            const maxStudentsToShow = 1;
            const hasMoreStudents = receiverStudentsFullNames && receiverStudentsFullNames.length > maxStudentsToShow;
            const studentsToShow = receiverStudentsFullNames ? receiverStudentsFullNames.slice(0, maxStudentsToShow) : [];
            
            const studentsList = receiverStudentsFullNames && receiverStudentsFullNames.length > 0
                ? `<div class="mt-3 bg-theme-seasalt p-3 rounded-lg border border-theme-rich-black/10">
                    <div class="flex justify-between items-center mb-2">
                        <h5 class="font-medium text-sm text-theme-rich-black/80 flex items-center">
                            <img src="/src/assets/icons/group-users.svg" alt="Group Users Icon" class="h-4 w-4 mr-2"/>
                            Participantes (${receiverStudentsFullNames.length})
                        </h5>
                        ${hasMoreStudents ? `
                            <button type="button" class="text-theme-keppel text-xs font-medium hover:underline view-more-btn" data-appointment-id="${apptDetails.id}">
                                Ver todos
                            </button>
                        ` : ''}
                    </div>
                    <ul class="space-y-1" id="students-list-${apptDetails.id}">
                        ${studentsToShow.map(s => `
                            <li class="flex items-center text-sm text-theme-rich-black/70">
                                <span class="w-1.5 h-1.5 bg-theme-keppel rounded-full mr-2"></span>
                                ${s}
                            </li>
                        `).join('')}
                    </ul>
                    ${hasMoreStudents ? `
                        <ul class="space-y-1 hidden mt-2" id="all-students-list-${apptDetails.id}">
                            ${receiverStudentsFullNames.map(s => `
                                <li class="flex items-center text-sm text-theme-rich-black/70">
                                    <span class="w-1.5 h-1.5 bg-theme-keppel rounded-full mr-2"></span>
                                    ${s}
                                </li>
                            `).join('')}
                        </ul>
                    ` : ''}
                </div>`
                : '';

            return `
                <div class="bg-white rounded-xl border border-theme-rich-black/10 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden h-fit">
                    <!-- Header con fecha/hora y estado -->
                    <div class="bg-gradient-to-r from-theme-keppel/5 to-theme-seasalt p-4 border-b border-theme-rich-black/10">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <img src="/src/assets/icons/calendar-blank.svg" alt="Calendar Icon" class="h-4 w-4 text-theme-keppel"/>
                                <span class="text-sm font-medium text-theme-rich-black">${formattedDate}</span>
                            </div>
                            <span class="px-2 py-1 rounded-full text-xs font-medium ${statusClass} border flex items-center gap-1">
                                ${statusIcon} ${apptDetails.state || 'PENDIENTE'}
                            </span>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-theme-rich-black/70">
                            <img src="/src/assets/icons/clock.svg" alt="Clock Icon" class="h-4 w-4"/>
                            <span>${formattedStartTime} - ${formattedEndTime}</span>
                        </div>
                    </div>
                    
                    <!-- Contenido principal -->
                    <div class="p-4">
                        <!-- Tipo de actividad -->
                        <div class="flex items-center gap-2 mb-3">
                            <div class="bg-theme-keppel/10 p-2 rounded-lg">
                                <img src="/src/assets/icons/writing-in-paper.svg" alt="Writing in Paper Icon" class="h-4 w-4"/>
                            </div>
                            <h4 class="font-semibold text-theme-rich-black">${apptDetails.typeActivity || 'Cita'}</h4>
                        </div>
                        
                        <!-- Información de personas -->
                        <div class="grid grid-cols-1 gap-2 mb-3 text-sm">
                            <div class="flex items-center text-theme-rich-black/70">
                                <img src="/src/assets/icons/instructor-outline.svg" alt="Instructor Icon" class="h-4 w-4 mr-2"/>
                                <span><strong class="text-theme-rich-black">Con:</strong> ${receiverFullName || 'Estudiantes Citados'}</span>
                            </div>
                            <div class="flex items-center text-theme-rich-black/70">
                                <img src="/src/assets/icons/student-outline.svg" alt="Student Icon" class="h-4 w-4 mr-2"/>
                                <span><strong class="text-theme-rich-black">De:</strong> ${senderFullName || '--'}</span>
                            </div>
                        </div>
                        
                        <!-- Detalles en formato tabla compacta -->
                        <div class="bg-theme-seasalt rounded-lg p-3 mb-3">
                            <table class="w-full text-sm">
                                <tbody>
                                    <tr>
                                        <td class="py-1 text-theme-rich-black/70 font-medium w-1/3">Modalidad:</td>
                                        <td class="py-1 text-theme-rich-black">${apptDetails.appointmentModality || '--'}</td>
                                    </tr>
                                    <tr>
                                        <td class="py-1 text-theme-rich-black/70 font-medium">Método:</td>
                                        <td class="py-1 text-theme-rich-black">${apptDetails.appointmentMethod || '--'}</td>
                                    </tr>
                                    ${apptDetails.specificAppointmentMethod ? `
                                    <tr>
                                        <td class="py-1 text-theme-rich-black/70 font-medium">Método esp.:</td>
                                        <td class="py-1 text-theme-rich-black">${apptDetails.specificAppointmentMethod}</td>
                                    </tr>
                                    ` : ''}
                                    <tr>
                                        <td class="py-1 text-theme-rich-black/70 font-medium">Razón:</td>
                                        <td class="py-1 text-theme-rich-black">${apptDetails.appointmentReason || '--'}</td>
                                    </tr>
                                    ${apptDetails.specificAppointmentReason ? `
                                    <tr>
                                        <td class="py-1 text-theme-rich-black/70 font-medium">Detalles:</td>
                                        <td class="py-1 text-theme-rich-black">${apptDetails.specificAppointmentReason}</td>
                                    </tr>
                                    ` : ''}
                                </tbody>
                            </table>
                        </div>
                        
                        ${studentsList}
                        
                        ${apptDetails.state === 'PENDIENTE' ? `
                        <div class="mt-3 pt-3 border-t border-theme-rich-black/10 space-y-3">
                            ${!isSent ? `
                            <div class="bg-gradient-to-br from-theme-seasalt to-theme-keppel/5 p-4 rounded-xl border border-theme-keppel/20">
                                <p class="text-sm font-medium text-theme-rich-black mb-3 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Selecciona un horario disponible:
                                </p>
                                <div class="space-y-2">
                                    ${['altScheduleA', 'altScheduleB', 'altScheduleC']
                                        .filter(key => apptDetails[key])
                                        .map((key, index) => {
                                            const dateTime = apptDetails[key];
                                            const formattedDate = formatDate(dateTime.split('T')[0]);
                                            const formattedTime = formatTime(dateTime.split('T')[1]);
                                            const dayName = getDayName(dateTime);
                                            
                                            return `
                                                <label class="flex items-start p-3 rounded-lg border-2 border-theme-rich-black/10 hover:border-theme-keppel/50 cursor-pointer transition-all duration-200 bg-white hover:shadow-md group">
                                                    <input type="radio" name="confirm-slot-${apptDetails.id}" value="${dateTime}" class="mt-0.5 text-theme-keppel focus:ring-theme-keppel mr-3 transform group-hover:scale-110 transition-transform">
                                                    <div class="flex-1">
                                                        <div class="flex items-center justify-between">
                                                            <span class="font-medium text-theme-rich-black">Opción ${index + 1}</span>
                                                            <span class="px-2 py-1 bg-theme-keppel/10 text-theme-keppel text-xs font-medium rounded-full">
                                                                ${dayName}
                                                            </span>
                                                        </div>
                                                        <div class="flex items-center space-x-3 mt-1 text-sm text-theme-rich-black/70">
                                                            <span class="flex items-center">
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                                </svg>
                                                                ${formattedDate}
                                                            </span>
                                                            <span class="flex items-center">
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                                </svg>
                                                                ${formattedTime}
                                                            </span>
                                                        </div>
                                                    </div>
                                                </label>
                                            `;
                                        }).join('')}
                                </div>
                            </div>
                            <button class="w-full bg-theme-keppel hover:bg-theme-keppel-dark text-white py-2 px-3 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-1.5 confirm-btn" data-appointment-id="${apptDetails.id}">
                                ✅ Confirmar cita
                            </button>
                            ` : ''}
                            <button class="w-full bg-red-50 hover:bg-red-100 text-red-600 hover:text-red-700 py-2 px-3 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-1.5 cancel-btn" data-appointment-id="${apptDetails.id}">
                                ❌ Cancelar cita
                            </button>
                        </div>
                        ` : ''}
                    </div>
                </div>
            `;
        }).join('');

        document.querySelectorAll('.cancel-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const appointmentId = this.getAttribute('data-appointment-id');
                await cancelAppointment(appointmentId);
            });
        });

        if (!isSent) {
            document.querySelectorAll('.confirm-btn').forEach(button => {
                button.addEventListener('click', async function() {
                    const appointmentId = this.getAttribute('data-appointment-id');
                    const selected = document.querySelector(`input[name="confirm-slot-${appointmentId}"]:checked`);
                    
                    if (!selected) {
                        alert('Debes seleccionar un horario antes de confirmar.');
                        return;
                    }

                    const chosenDateTime = selected.value;
                    await confirmAppointment(appointmentId, chosenDateTime);
                });
            });
        }
        document.querySelectorAll('.view-more-btn').forEach(button => {
            button.addEventListener('click', function() {
                const appointmentId = this.getAttribute('data-appointment-id');
                const studentsList = document.getElementById(`students-list-${appointmentId}`);
                const allStudentsList = document.getElementById(`all-students-list-${appointmentId}`);
                
                if (studentsList && allStudentsList) {
                    studentsList.classList.toggle('hidden');
                    allStudentsList.classList.toggle('hidden');
                    this.textContent = allStudentsList.classList.contains('hidden') ? 'Ver todos' : 'Ver menos';
                }
            });
        });
    }
</script>