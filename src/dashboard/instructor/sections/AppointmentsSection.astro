---
---

<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Gestión de Tutorías</h2>
    
    <div class="space-y-6">
        <!-- Citas Programadas -->
        <div>
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">Sesiones Programadas</h3>
                <span class="text-sm bg-theme-blue/10 text-theme-blue px-3 py-1 rounded-full">5 tutorías esta semana</span>
            </div>
            
            <div class="space-y-3">
                <!-- Tarjeta de cita 1 -->
                <div class="p-4 border border-theme-rich-black/20 rounded-xl bg-white hover:bg-theme-blue/5 transition-colors">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <span class="w-3 h-3 bg-theme-keppel rounded-full mr-2"></span>
                                <h4 class="font-medium">Tutoría Individual</h4>
                            </div>
                            <p class="text-sm text-gray-500 mb-1">Estudiante: Ana López (Matemáticas Avanzadas)</p>
                            <p class="text-sm text-gray-500">Hoy, 3:00 PM - 4:00 PM | Oficina D-205</p>
                        </div>
                        <div class="flex space-x-2">
                            <button class="p-2 text-theme-blue hover:bg-theme-blue/10 rounded-full transition-colors" title="Confirmar asistencia">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <button class="p-2 text-red-500 hover:bg-red-500/10 rounded-full transition-colors" title="Cancelar tutoría">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta de cita 2 -->
                <div class="p-4 border border-theme-rich-black/20 rounded-xl bg-white hover:bg-theme-blue/5 transition-colors">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <span class="w-3 h-3 bg-theme-yellow rounded-full mr-2"></span>
                                <h4 class="font-medium">Sesión de Grupo</h4>
                            </div>
                            <p class="text-sm text-gray-500 mb-1">3 estudiantes (Física Cuántica)</p>
                            <p class="text-sm text-gray-500">Mañana, 10:00 AM - 11:30 AM | Aula 302</p>
                        </div>
                        <div class="flex space-x-2">
                            <button class="p-2 text-theme-blue hover:bg-theme-blue/10 rounded-full transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                </svg>
                            </button>
                            <button class="p-2 text-red-500 hover:bg-red-500/10 rounded-full transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Programar Nueva Disponibilidad -->
        <div class="pt-4 border-t border-theme-rich-black/20">
            <h3 class="text-lg font-semibold mb-4">Agregar Horario Disponible</h3>
            <form class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Fecha</label>
                        <input type="date" class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Hora de inicio</label>
                        <input type="time" class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Duración</label>
                        <select class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                            <option>30 minutos</option>
                            <option>45 minutos</option>
                            <option>1 hora</option>
                            <option>1.5 horas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Tipo de sesión</label>
                        <select class="w-full p-3 border rounded-lg border-theme-rich-black/40">
                            <option>Individual</option>
                            <option>Grupo (max 3)</option>
                            <option>Grupo (max 5)</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                    <button type="submit" class="flex-1 bg-theme-blue text-white border-2 border-b-8 border-theme-rich-black font-medium py-3 px-6 rounded-2xl hover:bg-theme-blue/90 transition-colors duration-200">
                        Publicar Disponibilidad
                    </button>
                    <button type="button" class="flex-1 bg-white text-theme-rich-black border-2 border-b-8 border-theme-rich-black font-medium py-3 px-6 rounded-2xl hover:bg-gray-50 transition-colors duration-200">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>

        <!-- Calendario de disponibilidad -->
        <div class="pt-4 border-t border-theme-rich-black/20">
            <h3 class="text-lg font-semibold mb-4">Mi Calendario</h3>
            <div class="bg-gray-50 p-4 rounded-xl border border-dashed border-theme-rich-black/30 text-center">
                <p class="text-gray-500">Integración con calendario próximamente</p>
                <button class="mt-2 text-theme-blue hover:underline font-medium">
                    Ver calendario completo
                </button>
            </div>
        </div>
    </div>
</div>