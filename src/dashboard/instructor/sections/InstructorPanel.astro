---
import InstructorSidebar from '@/dashboard/instructor/components/InstructorSidebar.astro';
import DashboardSection from '@/dashboard/instructor/sections/DashboardSection.astro';
import EvaluateSection from '@/dashboard/instructor/sections/EvaluateSection.astro';
import ManageStudentsSection from '@/dashboard/instructor/sections/ManageStudentsSection.astro';
import AppointmentsSection from '@/dashboard/instructor/sections/AppointmentsSection.astro';
import AppointmentsScheduleSection from '@/dashboard/instructor/sections/AppointmentsScheduleSection.astro';
---

<section class="min-h-screen bg-theme-seasalt p-6 md:p-10">
    <!-- Header -->
    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-theme-rich-black">Panel de Docente</h1>
    </div>
    
    <!-- Contenido principal -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <InstructorSidebar />
        
        <!-- Contenido dinámico -->
        <main class="lg:col-span-3">
            <div id="dashboard-section" class="content-section">
                <DashboardSection />
            </div>
            <div id="evaluate-section" class="content-section">
                <EvaluateSection />
            </div>
            <div id="surveys-section" class="content-section">
                <ManageStudentsSection />
            </div>
            <div id="appointments-schedule-section" class="content-section">
                <AppointmentsScheduleSection />
            </div>
            <div id="appointments-section" class="content-section">
                <AppointmentsSection />
            </div>
        </main>
    </div>
</section>

<script type="module" is:inline>
    import { setupSectionListeners } from '/src/dashboard/shared/sectionManager.js';
    document.addEventListener('DOMContentLoaded', () => {
        setupSectionListeners('dashboard');
    });
</script>