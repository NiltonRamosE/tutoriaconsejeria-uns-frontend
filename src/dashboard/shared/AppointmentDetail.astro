---
import PrevStepButton from '@/shared/components/PrevStepButton.astro';
export interface Props {
  idPrefix: string;
}
const { idPrefix } = Astro.props;
---

<div class="form-step hidden" data-step="3" id={`${idPrefix}-detailsStep`}>
    <h3 class="text-lg font-semibold mb-4 text-theme-rich-black flex items-center">
        <span class="bg-theme-keppel text-white rounded-full h-8 w-8 flex items-center justify-center mr-2">
            <span id={`${idPrefix}-stepNumber`}>3</span>
        </span>
        <span id={`${idPrefix}-stepTitle`}>Completa los detalles de la cita</span>
    </h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <!-- Método de Cita -->
        <div>
            <label for={`${idPrefix}-appointmentMethod`} class="block text-sm font-medium mb-2 text-theme-rich-black/80">Método de Cita</label>
            <select id={`${idPrefix}-appointmentMethod`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent">
                <option value="">Seleccione un método</option>
                <option value="A">Personal</option>
                <option value="B">Telefónica</option>
                <option value="C">Correo electrónico</option>
                <option value="D">Chat</option>
                <option value="Otro">Otro</option>
            </select>
        </div>

        <!-- Método Específico de Cita -->
        <div id={`${idPrefix}-specificMethodContainer`} class="hidden">
            <label for={`${idPrefix}-specificAppointmentMethod`} class="block text-sm font-medium mb-2 text-theme-rich-black/80">Método Específico</label>
            <input type="text" id={`${idPrefix}-specificAppointmentMethod`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" placeholder="Ej: Google Meet, Zoom, etc.">
        </div>

        <!-- Razón de la Cita -->
        <div>
            <label for={`${idPrefix}-appointmentReason`} class="block text-sm font-medium mb-2 text-theme-rich-black/80">Razón de la Cita</label>
            <select id={`${idPrefix}-appointmentReason`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent">
                <option value="">Seleccione una razón</option>
                <option value="A">Rendimiento académico</option>
                <option value="B">Mejorar técnicas de estudio</option>
                <option value="C">Problemas de aprendizaje</option>
                <option value="D">Problemas interpersonales con estudiantes</option>
                <option value="E">Problemas de salud</option>
                <option value="F">Problemas interpersonales con docentes</option>
                <option value="G">Problemas interpersonales con otras personas</option>
                <option value="H">Problemas económicos</option>
                <option value="I">Problemas afectivos</option>
                <option value="J">Problemas familiares</option>
                <option value="Otro">Otro</option>
            </select>
        </div>

        <!-- Razón Específica de la Cita -->
        <div id={`${idPrefix}-specificReasonContainer`} class="hidden">
            <label for={`${idPrefix}-specificAppointmentReason`} class="block text-sm font-medium mb-2 text-theme-rich-black/80">Razón Específica</label>
            <input type="text" id={`${idPrefix}-specificAppointmentReason`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" placeholder="Describa brevemente la razón de la cita">
        </div>
    </div>

    <!-- Horarios Alternativos -->
    <div class="mb-4">
        <span class="block text-sm font-medium mb-2 text-theme-rich-black/80">Horarios Alternativos</span>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
                <label for={`${idPrefix}-altScheduleA`} class="block text-sm font-medium mb-1 text-theme-rich-black/70">Primera Opción</label>
                <input type="datetime-local" id={`${idPrefix}-altScheduleA`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
            </div>
            <div>
                <label for={`${idPrefix}-altScheduleB`} class="block text-sm font-medium mb-1 text-theme-rich-black/70">Segunda Opción</label>
                <input type="datetime-local" id={`${idPrefix}-altScheduleB`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
            </div>
            <div>
                <label for={`${idPrefix}-altScheduleC`} class="block text-sm font-medium mb-1 text-theme-rich-black/70">Tercera Opción</label>
                <input type="datetime-local" id={`${idPrefix}-altScheduleC`} class="w-full p-3 border rounded-lg border-theme-rich-black/30 focus:ring-2 focus:ring-theme-keppel focus:border-transparent" required>
            </div>
        </div>
    </div>

    <div class="flex justify-between">
        <PrevStepButton />
        <button type="submit" class="bg-theme-keppel text-white font-medium py-2 px-6 rounded-lg hover:bg-theme-keppel-dark transition-colors duration-200">
            Programar Cita
        </button>
    </div>
</div>