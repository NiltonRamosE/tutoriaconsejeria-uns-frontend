---
import ScheduleTable from "@/dashboard/shared/ScheduleTable.astro";
---

<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Horarios Académicos</h2>
    
    <div class="space-y-6">
        <!-- Selector de Ciclo -->
        <div class="flex flex-col xs:flex-row items-start xs:items-center gap-3 xs:gap-4">
            <!-- Etiqueta -->
            <label for="cycleSelect" class="text-sm font-medium text-theme-rich-black xs:whitespace-nowrap">
                Seleccionar Ciclo:
            </label>
            
            <!-- Contenedor de controles -->
            <div class="flex flex-col sm:flex-row gap-3 w-full xs:w-auto">
                <!-- Selector -->
                <select 
                    id="cycleSelect"
                    class="border rounded-md px-3 py-2 text-sm border-theme-rich-black/40 focus:ring-theme-keppel focus:border-theme-keppel w-full sm:w-auto"
                >
                    <option value="1" selected>PRIMERO</option>
                    <option value="2">SEGUNDO</option>
                    <option value="3">TERCERO</option>
                    <option value="4">CUARTO</option>
                    <option value="5">QUINTO</option>
                    <option value="6">SEXTO</option>
                    <option value="7">SEPTIMO</option>
                    <option value="8">OCTAVO</option>
                    <option value="9">NOVENO</option>
                    <option value="10">DECIMO</option>
                </select>
                
                <!-- Botón -->
                <button 
                    id="loadScheduleBtn"
                    class="bg-theme-keppel text-white px-4 py-2 rounded-md hover:bg-theme-keppel-dark transition-colors whitespace-nowrap w-full sm:w-auto"
                >
                    Cargar Horario
                </button>
            </div>
        </div>

        <!-- Loading State -->
        <div id="loadingIndicator" class="hidden text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-theme-keppel"></div>
            <p class="mt-2 text-theme-rich-black">Cargando horarios...</p>
        </div>

        <!-- Schedule Display -->
        <ScheduleTable idPrefix="academic" />

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-8">
            <p class="text-gray-500">No se encontraron horarios para este ciclo.</p>
        </div>
    </div>
</div>

<script type="module" is:inline>
    import { createScheduleRenderer } from "/src/dashboard/shared/scheduleManager.js";
    import { fetchAcademicSchedules } from "/src/dashboard/services/academicScheduleService.js";
    import { getToken } from '/src/dashboard/shared/auth.js';

    const token = getToken();
    const sched = createScheduleRenderer('academic');
    const cycleSelect = document.getElementById('cycleSelect');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const emptyState = document.getElementById('emptyState');
    
    document.getElementById('loadScheduleBtn').addEventListener('click', loadSchedule);

    function getCycleName(cycleNumber) {
        const cycleNames = { '1':'I','2':'II','3':'III','4':'IV','5':'V','6':'VI','7':'VII','8':'VIII','9':'IX','10':'X' };
        return cycleNames[cycleNumber] || cycleNumber;
    }

    async function loadSchedule() {
        const selectedCycle = cycleSelect.value;

        loadingIndicator.classList.remove('hidden');
        sched.hide();
        emptyState.classList.add('hidden');

        try {
            if (!token) throw new Error('No autenticado');

            const scheduleData = await fetchAcademicSchedules(selectedCycle, token);

            sched.setTitle(`Horario - Ciclo ${getCycleName(selectedCycle)}`);
            sched.render(scheduleData, { emptyStateId: 'emptyState' });
            sched.show();
        } finally {
            loadingIndicator.classList.add('hidden');
        }
    }
</script>