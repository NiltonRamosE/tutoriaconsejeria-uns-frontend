---
import StudentsTable from '@/dashboard/administrator/components/StudentsTable.astro';
import AdminSidebar from '@/dashboard/administrator/components/AdminSidebar.astro';

const { students } = Astro.props;
---

<section class="min-h-screen bg-theme-seasalt p-6 md:p-10">
    <!-- Header -->
    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-theme-rich-black">Panel de Administrador</h1>
    </div>
    
    <!-- Contenido principal -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <AdminSidebar currentPage="assign" />
        
        <!-- Contenido principal -->
        <main class="lg:col-span-3">
            <StudentsTable {students} />
        </main>
    </div>
</section>