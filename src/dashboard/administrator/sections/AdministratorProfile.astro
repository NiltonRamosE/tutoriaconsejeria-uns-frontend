<div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
        <h2 class="text-2xl font-bold text-theme-rich-black">Perfil de Administrador</h2>
    </div>
    
    <div class="flex flex-col md:flex-row gap-8">
        <div class="flex flex-col items-center">
            <div class="relative w-32 h-32 rounded-full bg-theme-keppel/20 flex items-center justify-center overflow-hidden border-4 border-theme-keppel/30">
                <span id="genderIcon" class="text-5xl">
                    <!-- Se llenará dinámicamente -->
                </span>
            </div>
            <button class="mt-4 text-theme-keppel hover:text-theme-keppel-dark text-sm font-medium text-center w-full">
                Cambiar foto
            </button>
        </div>
        
        <div class="flex-1">
            <div class="space-y-4">
                <div>
                    <span class="block text-sm font-medium text-theme-rich-black/70 mb-1">Nombre completo</span>
                    <div class="bg-theme-seasalt p-3 rounded-lg border border-theme-rich-black/20">
                        <p id="administratorNameProfileSection" class="text-theme-rich-black"></p>
                    </div>
                </div>
                
                <div>
                    <span class="block text-sm font-medium text-theme-rich-black/70 mb-1">Correo institucional</span>
                    <div class="bg-theme-seasalt p-3 rounded-lg border border-theme-rich-black/20">
                        <p id="administratorInstitutionalEmailProfileSection" class="text-theme-rich-black"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script is:inline>
    const administratorData = JSON.parse(localStorage.getItem('user')) || null;

    if (administratorData) {
        document.getElementById('administratorNameProfileSection').textContent = administratorData.fullName || 'Administrador';
        document.getElementById('administratorInstitutionalEmailProfileSection').textContent = administratorData.institutionalEmail || 'Administrador';

        const genderIconContainer = document.getElementById('genderIcon');
        let iconPath = '/src/assets/icons/administrator-outline.svg';
        let altText = 'Icono de Administrador';

        if (administratorData.gender === 'M') {
            iconPath = '/src/assets/icons/male-user.svg';
            altText = 'Icono Masculino';
        } else if (administratorData.gender === 'F') {
            iconPath = '/src/assets/icons/female-user.svg';
            altText = 'Icono Femenino';
        }

        // Insertar el SVG correspondiente
        genderIconContainer.innerHTML = `
            <img src="${iconPath}" 
                    alt="${altText}" 
                    class="w-16 h-16 object-contain" />
        `;
    }
</script>