---
import AdminProfileCard from '@/dashboard/administrator/components/AdminProfileCard.astro';
const { currentPage } = Astro.props;
---

<aside class="lg:col-span-1 space-y-6">
    <!-- Perfil -->
    <AdminProfileCard user={{ name: "Administrador" }} />
    
    <!-- Acciones -->
    <div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
        <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Acciones</h2>
        
        <nav class="space-y-4">
            <a 
                href="/dashboard/administrator/assign" 
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentPage === 'assign' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Asignar Estudiantes</h3>
                        <p class="text-sm text-gray-600">Gestiona la asignación de tutorados</p>
                    </div>
                </div>
            </a>
            
            <a 
                href="/dashboard/administrator/users" 
                class={`block p-4 rounded-xl transition-all duration-300 border group ${currentPage === 'users' ? 'bg-theme-keppel/10 border-theme-keppel' : 'hover:bg-theme-keppel/5 border-theme-rich-black/20'}`}
            >
                <div class="flex items-center">
                    <div class="mr-4 w-10 h-10 bg-theme-keppel/20 rounded-xl flex items-center justify-center group-hover:bg-theme-keppel/30 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-theme-keppel" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold">Gestión de Usuarios</h3>
                        <p class="text-sm text-gray-600">Administra estudiantes y docentes</p>
                    </div>
                </div>
            </a>
            
            <!-- Más items del menú según necesites -->
        </nav>
    </div>
</aside>