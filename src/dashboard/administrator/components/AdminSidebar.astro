---
import AdminProfileCard from '@/dashboard/administrator/components/AdminProfileCard.astro';
import LogoutButton from '@/shared/components/LogoutButton.astro';
import ItemSidebar from '@/shared/components/ItemSidebar.astro';
---

<aside class="lg:col-span-1 space-y-6">
    <!-- Perfil -->
    <AdminProfileCard user={{ name: "Administrador" }} />
    
    <!-- Acciones -->
    <div class="bg-white p-6 rounded-3xl shadow-lg border-2 border-b-8 border-theme-rich-black">
        <h2 class="text-2xl font-bold mb-6 text-theme-rich-black">Acciones</h2>
        
        <nav class="space-y-4">
            
            <ItemSidebar
                href="#"
                section="assign"
                title="Asignar Estudiantes"
                description="Gestiona la asignación de tutorados"
                iconSrc="/src/assets/icons/team-person-outline.svg"
            />

            <ItemSidebar
                href="#"
                section="students"
                title="Gestión de Estudiantes"
                description="Administra estudiantes"
                iconSrc="/src/assets/icons/team-person-fill.svg"
            />

            <ItemSidebar
                href="#"
                section="instructors"
                title="Gestión de Docentes"
                description="Administra docentes"
                iconSrc="/src/assets/icons/team-person-fill.svg"
            />

            <ItemSidebar
                href="#"
                section="academic-schedule"
                title="Horarios Académicos Estudiantes"
                description="Verifica horarios de estudiantes en el semestre lectivo"
                iconSrc="/src/assets/icons/calendar-blank.svg"
            />

            <ItemSidebar
                href="#"
                section="instructor-schedule"
                title="Horarios Académicos Docentes"
                description="Verifica horarios de docentes en el semestre lectivo"
                iconSrc="/src/assets/icons/calendar-blank.svg"
            />
            
            <div class="pt-4 border-t border-theme-rich-black/20">
                <LogoutButton />
            </div>
        </nav>
    </div>
</aside>