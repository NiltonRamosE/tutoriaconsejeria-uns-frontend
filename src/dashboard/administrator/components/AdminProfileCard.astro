<div class="flex items-center space-x-4 bg-white p-4 rounded-2xl shadow-md border-2 border-theme-rich-black/10">
    <div class="w-12 h-12 rounded-full bg-theme-keppel flex items-center justify-center text-white text-xl">
        <img src="/src/assets/icons/administrator-outline.svg" alt="Icono de Administrador" class="h-5 w-5" />
    </div>
    <div>
        <p id="profileCardFullName" class="font-semibold text-theme-rich-black"></p>
        <a href="#" data-section="administrator-profile" class="text-sm text-theme-keppel hover:underline">Ver perfil</a>
    </div>
</div>

<script is:inline>
    const userData = JSON.parse(localStorage.getItem('user')) || null;

    if (userData) {
        document.getElementById('profileCardFullName').textContent = userData.fullName || 'Administrador';
    }
</script>