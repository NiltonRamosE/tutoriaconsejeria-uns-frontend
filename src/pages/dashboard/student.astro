---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
const robots = ["noindex", "nofollow"];
const title = "Plataforma de Estudiante";
const description = "Plataforma de Estudiante de Tutoría y Consejería UNS. Accede a recursos, gestiona tu progreso y mejora tu bienestar personal.";
const keywords = ["plataforma estudiante", "bienestar personal", "gestión de progreso", "Tutoría y Consejería UNS", "recursos estudiantiles"];
const url = "https://tutoriaconsejeriauns.vercel.app/dashboard/student";
const imageOG = "/card-twt.webp";
const imagetwt = "/card-twt.webp";
---

<ProtectedLayout {robots} {title} {description} {keywords} {url} {imageOG} {imagetwt}>
    Estudiante
</ProtectedLayout>
