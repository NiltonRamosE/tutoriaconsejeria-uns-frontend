---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
const robots = ["noindex", "nofollow"];
const title = "Plataforma de Docente";
const description = "Plataforma de Docente de Tutoría y Consejería UNS. Accede a herramientas, gestiona tu curso y mejora la experiencia educativa.";
const keywords = ["plataforma docente", "gestión de curso", "Tutoría y Consejería UNS", "herramientas educativas", "experiencia educativa"];
